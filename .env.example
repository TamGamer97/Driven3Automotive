# AutoTrader Connect (sandbox by default)
# From the Connect portal: "key" is often the integration id string; "secret" is the long token.
AT_API_KEY=your_integration_key
AT_API_SECRET=your_secret_token
AT_API_BASE=https://api-sandbox.autotrader.co.uk

# Recommended for production (your public dealer URL uses this id)
# AT_ADVERTISER_ID=10042640
# AT_ADVERTISER_NAME=driven3

# Cache stock responses (seconds)
AT_STOCK_CACHE_SECONDS=300
